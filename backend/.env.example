# SkillGap AI & ATS Scorer — Backend Environment Variables

# Server Configuration
ENVIRONMENT=development
PORT=8000

# Supabase Configuration (Get from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=resumes

# JWT Security Secrets (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=super-secret-jwt-key-for-skillgap-ai-2026
JWT_REFRESH_SECRET_KEY=super-secret-refresh-jwt-key-skillgap-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cloud Storage (Optional if using Supabase Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI / LLM Integration (Groq Cloud - Free tier available at https://console.groq.com)
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# External APIs (Optional)
GNEWS_API_KEY=
YOUTUBE_API_KEY=
